{
  "name": "server",
  "scripts": {
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "migrate:latest": "bun run ./src/db/migrateToLatest.ts",
    "migrate:up": "bun run ./src/db/migrateUp.ts",
    "migrate:down": "bun run ./src/db/migrateDown.ts",
    "migrate:reset": "bun run ./src/db/migrateReset.ts",
    "db:typegen": "kysely-codegen --out-file ./src/db/schema.ts --singularize",
    "db:seed": "bun run ./src/db/seeders/index.ts"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.0",
    "argon2": "^0.45.1",
    "arkenv": "^0.12.3",
    "arktype": "^2.2.3",
    "date-fns": "^4.4.0",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "mysql2": "^3.24.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "^7.0.2"
  }
}
